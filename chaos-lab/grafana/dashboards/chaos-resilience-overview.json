  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Key System Health Indicators",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Throughput (RPS)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"orders-service\"}[10s])) or vector(0)",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 },
              { "color": "orange", "value": 150 },
              { "color": "red", "value": 350 }
            ]
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "p99 Response Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000 or vector(0)",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "title": "Tomcat Busy Threads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(tomcat_threads_busy_threads{application=\"orders-service\"}) or vector(0)",
          "legendFormat": "Busy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Redis Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "max(redis_memory_used_bytes)",
          "legendFormat": "Memory",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Traffic, Latency & Error Cascade",
      "type": "row"
    },
    {
      "id": 5,
      "title": "HTTP Latency Distribution (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p50 (Median)",
          "refId": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p99 (Peak Tail)",
          "refId": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP Response Status Codes (201 OK vs 429 Throttle vs 5xx Timeout)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"orders-service\"}[15s])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🗄️ Infrastructure Bottleneck Gauges (DB Pool & Redis)",
      "type": "row"
    },
    {
      "id": 7,
      "title": "HikariCP Connection Pool (Max: 30 / node)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"orders-service\"}",
          "legendFormat": "Active ({{node}})",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"orders-service\"}",
          "legendFormat": "Idle ({{node}})",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"orders-service\"}",
          "legendFormat": "Pending ({{node}})",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Redis Commands/Sec & Connected Clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "rate(redis_commands_total[15s])",
          "legendFormat": "Commands/sec",
          "refId": "A"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Connected Clients",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "none"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "🔀 Multi-Instance Load Balancing & Failover",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Throughput per App Node (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"orders-service\"}[10s])) by (node)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 10,
      "title": "App Nodes UP / DOWN (1 = UP, 0 = DOWN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "up{job=\"orders-service\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 3, "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "min": 0,
          "max": 1.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 11,
      "title": "Outbox Publish Rate & Pending Rows",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(outbox_events_published_total{application=\"orders-service\"}[15s]))",
          "legendFormat": "Published/sec (Cluster)",
          "refId": "A"
        },
        {
          "expr": "max(outbox_events_pending{application=\"orders-service\"})",
          "legendFormat": "Pending Rows (DB)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none"
        }
      }
