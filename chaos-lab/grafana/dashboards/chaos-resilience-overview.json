    },
    {
      "id": 5,
      "title": "HTTP Latency Distribution (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p50 (Median)",
          "refId": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"orders-service\"}[30s])) by (le)) * 1000",
          "legendFormat": "p99 (Peak Tail)",
          "refId": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP Response Status Codes (201 OK vs 429 Throttle vs 5xx Timeout)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"orders-service\"}[15s])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
